<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>CXLauncher</AssemblyName>
    <RootNamespace>CXLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.6.0</Version>
    <ApplicationIcon>Assets\Icons\cx-launcher.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\Shaders\*.ps" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
</Project>
