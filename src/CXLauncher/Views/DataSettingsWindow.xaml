<Window x:Class="CXLauncher.Views.DataSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="数据与设置" Width="620" Height="560" MinWidth="480" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="数据与设置" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="你的游戏库，在自己的电脑上。" Style="{StaticResource MutedText}" Margin="0,6,0,24" />
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
          <StackPanel>
            <TextBlock Text="本地数据目录" FontWeight="SemiBold" />
            <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,12" FontSize="12" AutomationProperties.Name="本地数据目录" />
            <TextBlock Text="游戏库、设置和封面保存在此。有效配置自动保留最近 5 份备份。" Style="{StaticResource MutedText}" FontSize="12" />
          </StackPanel>
        </Border>
        <TextBlock Text="备份与迁移" FontWeight="SemiBold" Margin="0,24,0,12" />
        <StackPanel Orientation="Horizontal">
          <Button Content="导入游戏库…" Command="{Binding ImportCommand}" />
          <Button Content="导出游戏库…" Command="{Binding ExportCommand}" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock Text="导入前会预览合并数量，同路径不会重复添加。JSON 只包含条目；迁移图片请一并备份 covers 文件夹。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,16" />
        <StackPanel Visibility="{Binding SettingsBlocked, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="设置文件读取失败，当前使用临时默认值。" Foreground="{StaticResource ErrorBrush}" />
          <Button Content="保留原文件并恢复设置" Command="{Binding RecoverSettingsCommand}" HorizontalAlignment="Left" Margin="0,10,0,12" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="完成" IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,20,0,0" />
  </Grid>
</Window>
