<Window x:Class="CXLauncher.Views.GameEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="600" Height="730" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="把入口留在这里，把时间留给游戏。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanSave}">
        <Label Content="游戏名称" Target="{Binding ElementName=NameInput}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,8" />
        <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="游戏名称" />
        <TextBlock Text="{Binding NameError}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,4,0,4" />
        <Label Content="游戏路径" Target="{Binding ElementName=PathInput}" Foreground="{StaticResource MutedBrush}" Padding="0,8,0,8" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="PathInput" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏路径" />
          <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseTarget" />
        </Grid>
        <TextBlock Text="{Binding PathError}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,4,0,4" />
        <TextBlock Text="支持 .exe 程序和 .lnk 快捷方式。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,16" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="分类" Target="{Binding ElementName=CategoryInput}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,8" />
            <TextBox x:Name="CategoryInput" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="分类" />
          </StackPanel>
          <CheckBox Grid.Column="1" Content="加入收藏" IsChecked="{Binding Favorite}" Margin="20,22,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="本地封面" Style="{StaticResource MutedText}" Margin="0,20,0,8" />
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CoverCaption}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="选择图片…" Click="BrowseCover" />
          </Grid>
        </Border>
        <CheckBox Content="移除封面，使用程序图标" IsChecked="{Binding RemoveCover}" Margin="0,8,0,0" />
        <TextBlock Text="推荐 2:3 比例；封面将复制到应用数据目录。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,4" />
        <Expander Header="高级设置 · 参数与工作目录" IsEnabled="{Binding IsExecutable}">
          <StackPanel Margin="0,12,0,4">
            <Label Content="启动参数" Target="{Binding ElementName=ArgumentsInput}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,8" />
            <TextBox x:Name="ArgumentsInput" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="启动参数" />
            <Label Content="工作目录（留空使用程序所在文件夹）" Target="{Binding ElementName=WorkInput}" Foreground="{StaticResource MutedBrush}" Padding="0,16,0,8" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="WorkInput" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="工作目录" />
              <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseDirectory" />
            </Grid>
          </StackPanel>
        </Expander>
        <TextBlock Text="快捷方式沿用自身的参数和工作目录。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="{Binding SaveError}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" MinWidth="88" IsEnabled="{Binding CanSave}" />
        <Button Content="保存游戏" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="120" Margin="12,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
