<UserControl x:Class="CXLauncher.Views.GameDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CXLauncher.Views">
  <views:GlassSurface Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid Margin="0,0,0,16">
          <TextBlock Text="游戏详情" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
          <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Command="{Binding CloseDetailsCommand}" ToolTip="关闭详情 · Esc" AutomationProperties.Name="关闭游戏详情" />
        </Grid>
        <Border x:Name="DetailsCover" CornerRadius="8" ClipToBounds="True" Height="210"><views:GameArtwork DataContext="{Binding SelectedGame}" /></Border>
        <StackPanel x:Name="DetailsBody">
        <TextBlock Text="{Binding SelectedGame.Name}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,6" ToolTip="{Binding SelectedGame.Name}" />
        <TextBlock Text="{Binding SelectedGame.Category}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
        <Button Content="{Binding SelectedGame.LaunchCaption}" Command="{Binding LaunchCommand}" CommandParameter="{Binding SelectedGame}" Style="{StaticResource PrimaryButton}" />
        <TextBlock Text="{Binding SelectedGame.Availability}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,20" />
        <TextBlock Text="游戏路径" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBox Text="{Binding SelectedGame.TargetPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16" AutomationProperties.Name="游戏路径" />
        <TextBlock Text="最近启动" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBlock Text="{Binding SelectedGame.LastLaunchCaption}" Margin="0,6,0,16" />
        <TextBlock Text="添加时间" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBlock Text="{Binding SelectedGame.AddedCaption}" Margin="0,6,0,20" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button Content="编辑游戏" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedGame}" Margin="0,0,6,0" Padding="8,10" />
          <Button Grid.Column="1" Content="{Binding SelectedGame.FavoriteCaption}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedGame}" Margin="6,0,0,0" Padding="8,10" />
        </Grid>
        <Button Content="移出游戏库" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedGame}" Foreground="{StaticResource ErrorBrush}" Background="Transparent" Margin="0,12,0,0" />
        <TextBlock Text="移除条目会保留游戏文件。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </views:GlassSurface>
</UserControl>
